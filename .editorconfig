root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{js,ts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# The release merge contract preserves CRLF for the changelog; all other text uses LF.
[CHANGELOG.md]
end_of_line = crlf

[*.{sln}]
indent_style = tab

# PowerShell: UTF-8 *with BOM* so Windows PowerShell 5.1 parses non-ASCII
# characters correctly (it reads BOM-less .ps1 as ANSI, which mangles
# em-dashes/arrows and can break the tokenizer). pwsh 7 reads BOM fine too.
[*.ps1]
charset = utf-8-bom
